+                JobEvent::Started { index, .. } => Some(*index),
+                _ => None,
+            })
+            .collect();
+        assert_eq!(
+            started,
+            vec![0],
+            "only the in-flight job may start once cancelled"
+        );
+        assert!(kills.load(Ordering::SeqCst) >= 1, "killer must be invoked");
+    }
+}
