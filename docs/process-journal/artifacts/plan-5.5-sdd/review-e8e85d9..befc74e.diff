 fn scalar_fits(value: &Scalar, t: PropType) -> bool {
     matches!(
         (value, t),
         (Scalar::Str(_), PropType::String)
             | (Scalar::Bool(_), PropType::Boolean)
             | (Scalar::Int(_), PropType::Integer)
             | (Scalar::Int(_), PropType::Float)
             | (Scalar::Float(_), PropType::Float)
     )
 }
