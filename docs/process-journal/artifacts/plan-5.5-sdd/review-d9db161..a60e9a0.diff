 // Drop the plan for any file that has an error-severity diagnostic (spec 5.1).
 fn finalize_plans(files: &mut [FileReport]) {
     for f in files.iter_mut() {
         if f.diagnostics.iter().any(|d| d.severity == Severity::Error) {
             f.plan = None;
         }
     }
 }
 
