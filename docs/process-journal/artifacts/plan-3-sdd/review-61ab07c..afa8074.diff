+#[test]
+fn attachments_subset_on_primary_no_attachments_on_donor() {
+    let plan = multi_group_plan(
+        AttachmentPlan {
+            primary: PrimaryAttachments::Subset(vec![0, 2]),
+            add_files: vec![],
