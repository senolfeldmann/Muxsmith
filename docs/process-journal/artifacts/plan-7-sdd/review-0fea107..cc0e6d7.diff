+ *  REPLACES the bundles array, never mutates it (the setter is
+ *  shallowRef-backed; every $t/$ta/v-t tracks it). */
+export const currentLocale = shallowRef("en");
+export const fluent = createFluentVue({ bundles: buildBundles("en") });
