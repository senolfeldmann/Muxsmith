+/// `PropType -> TS tag` is total over all four real variants: a fifth
+/// `PropType` variant fails this match at build time rather than silently
+/// falling through a wildcard arm (the house never-arm shape, D46).
+fn scalar_tag(t: PropType) -> &'static str {
+    match t {
+        PropType::String => "string",
+        PropType::Boolean => "boolean",
+        PropType::Integer => "integer",
+        PropType::Float => "float",
+    }
+}
+
+#[test]
+fn emit_settables_ts() {
+    let dir = std::env::var("TS_RS_EXPORT_DIR").unwrap();
+    let mut out = String::from("// @generated by `cargo test -p muxsmith-core --features ts`\n");
+    out.push_str(
+        "export type PropScalarType = \"boolean\" | \"integer\" | \"float\" | \"string\";\n",
+    );
+
+    out.push_str("export const SETTABLE_TYPES = {\n");
+    for (name, ty, _option) in SETTABLE {
+        out.push_str(&format!("  \"{name}\": \"{}\",\n", scalar_tag(*ty)));
+    }
+    out.push_str("} as const satisfies Record<string, PropScalarType>;\n");
+
+    out.push_str("export const MATCHABLE_TYPES = {\n");
+    for (name, ty) in matchable_properties() {
+        out.push_str(&format!("  \"{name}\": \"{}\",\n", scalar_tag(*ty)));
+    }
+    out.push_str(&format!(
+        "  \"codec_kind\": \"{}\",\n",
+        scalar_tag(matchable_type("codec_kind").unwrap())
+    ));
+    out.push_str("} as const satisfies Record<string, PropScalarType>;\n");
+
+    std::fs::write(Path::new(&dir).join("settables.ts"), out).unwrap();
+}
