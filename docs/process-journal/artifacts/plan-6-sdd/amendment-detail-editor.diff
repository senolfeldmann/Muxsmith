+  v-if="selectedRule"
+  data-testid="editor-rule-detail"
+  :aria-labelledby="`editor-rule-row-${selectedIndex}`"
+>
+  <SectionWidget
+    :spec="ruleDetailSpec"
+    :model-value="selectedRule"
