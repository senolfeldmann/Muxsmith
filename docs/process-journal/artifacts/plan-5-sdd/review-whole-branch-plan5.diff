+    // -- D31: close decision + quit-after-finished ----------------------------
+
+    #[test]
+    fn close_decision_lets_an_idle_window_close_normally() {
+        let state = AppState::default();
+        assert_eq!(close_decision(&state), CloseDecision::Close);
+
