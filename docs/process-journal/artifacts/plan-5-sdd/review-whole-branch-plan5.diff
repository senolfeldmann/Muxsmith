+
+    // --- detect_mkvmerge_body ---
+
+    /// See `identify_body_broken_override_maps_to_mkvmerge_spawn_failed`'s
+    /// doc for why a nonexistent override maps to `mkvmerge-spawn-failed`,
+    /// not `mkvmerge-not-found`.
+    #[test]
