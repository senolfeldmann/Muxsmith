+function addRule() {
+  if (!model.value) return;
+  const next = [...rules.value, { match: {} }];
+  model.value = {
+    ...model.value,
+    tracks: { ...model.value.tracks, rules: next },
+  };
+  selectedIndex.value = next.length - 1;
+}
